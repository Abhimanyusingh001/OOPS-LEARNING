/*
    copy CONSTRUCTORS
    Used to copy one object into another.
*/

class student{
    public:
    int x;
    student(int a){
        x=a;
    }
    student(student &t){
        x=t.x;
    }
    void value(){
        cout<<"The value will be "<<x<<endl;
    }
};

int main(){
    student s1(20);
    student s2=s1;
    s2.value();
}
