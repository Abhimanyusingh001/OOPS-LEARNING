#include <bits/stdc++.h>
using namespace std;
/*
        A CLASS IS A BLUEPRINT THAT IS USED TO CREATE OBJECT
        
        A CLASS CONTAINS VARIBLES
        
        MEMEBER FUNTIONS 
        
        AND ACCESS SPECIFIER. 
        
        OBJECT IS AN INSTANCE OF A CLASS WHERE MEMORY ALLOCATION HAPPENDS 
        
        NOT AT THE TIME OF DECLARTION OF THE CLASS
        
        EXAMPLE
          


*/
class book{
    public:
    string name;
    int price;
    
    void display(){
        cout<<"Name of the book is : "<<name<<endl;
        cout<<"Price of the book is : "<<price;
    }
    
};
int main() {
	book b1;
	b1.name="Harry potter";
	b1.price=200;
	b1.display();
}
